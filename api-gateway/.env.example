# API Gateway
PORT=3006
NODE_ENV=development

# Clé publique RSA pour vérifier les JWT RS256 émis par auth-service
# Doit correspondre à JWT_PUBLIC_KEY de auth-service
# Stocker le contenu PEM avec \n échappés (cf. auth-service/.env.example)
JWT_PUBLIC_KEY=

# URLs des services en aval
AUTH_SERVICE_URL=http://localhost:3000
COMPANY_SERVICE_URL=http://localhost:3001
FLEET_SERVICE_URL=http://localhost:3003
SHIPMENT_SERVICE_URL=http://localhost:3002
TRACKING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
