# API Gateway
PORT=3006
NODE_ENV=development

# JWT (doit correspondre au JWT_SECRET de auth-service)
JWT_SECRET=change_me_in_production

# URLs des services en aval
AUTH_SERVICE_URL=http://localhost:3000
COMPANY_SERVICE_URL=http://localhost:3001
FLEET_SERVICE_URL=http://localhost:3003
SHIPMENT_SERVICE_URL=http://localhost:3002
TRACKING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
