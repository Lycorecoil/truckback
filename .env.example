# MongoDB — générer avec : node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_generate_a_strong_password

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_generate_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_generate_another_random_64_char_hex_string

# Redis (rate limiting partagé entre instances api-gateway)
REDIS_URL=redis://redis:6379

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Twilio SMS — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Notifications
FALLBACK_EMAIL=ilboudojeanbaptiste41@gmail.com

# CORS — domaines frontend autorisés (séparés par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Grafana — mot de passe admin de l'interface (http://localhost:3008)
GRAFANA_PASSWORD=change_me_strong_grafana_password
