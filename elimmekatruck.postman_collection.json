          "name": "Signup — Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('company_user_id', res.id);",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token_company', res.token);",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
