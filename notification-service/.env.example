PORT=3005
DATABASE_URL=mongodb://localhost:27017/notification-service

# SMTP Gmail — utiliser un "App Password" Google (pas le mot de passe principal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
AT_SENDER_ID=CamionUber
AT_SANDBOX=true
