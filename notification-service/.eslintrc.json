{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "ignoreRestSiblings": true
    }],
    "no-console": "warn"
  },
  "env": { "node": true, "es2020": true },
  "ignorePatterns": ["dist/", "node_modules/", "coverage/"]
}
