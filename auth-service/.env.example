PORT=3000
DATABASE_URL=mongodb://localhost:27017/auth-service
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Clés RSA pour RS256 — générer avec :
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# En production, stocker le contenu du fichier avec \n échappés :
#   JWT_PRIVATE_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jwt_private.pem)"
#   JWT_PUBLIC_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jwt_public.pem)"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
